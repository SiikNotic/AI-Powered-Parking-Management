# Data source for the dashboard: "mock" (demo data, default) or "supabase" (next phase).
VITE_DATA_SOURCE=mock

# Routing: leave unset for normal URLs, or "hash" for static hosts without SPA rewrites.
# VITE_ROUTER=hash

# Supabase (next phase) — public values only. NEVER put a service_role key here.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
