# Data source: "demo" (default, in-browser sample farm). A Supabase adapter
# implementing src/services/contracts.ts is the next phase.
VITE_DATA_SOURCE=demo

# Supabase (future). Only the public anon key belongs in the frontend —
# never a service_role key. Leave empty until the project exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "hash" for static hosts without SPA rewrites (GitHub Pages).
VITE_ROUTER=
