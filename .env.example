# Data source: "demo" (default, in-browser sample farm) or "supabase".
VITE_DATA_SOURCE=demo

# Supabase: only the public project URL and anon/publishable key belong in
# the frontend. Never a service_role key. Put real values in .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "hash" for static hosts without SPA rewrites (GitHub Pages).
VITE_ROUTER=
